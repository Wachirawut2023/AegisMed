# ─────────────────────────────────────────────────────────────
# AegisMed configuration
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Your Google Cloud project ID. AegisMed calls Vertex AI's Gemini API in
# this project. No API key involved — authentication is Application
# Default Credentials:
#   locally: run `gcloud auth application-default login` once
#   on Cloud Run: the service's attached service account handles it
#                 automatically (grant it the roles/aiplatform.user role)
GOOGLE_CLOUD_PROJECT=

# Which region to call Vertex AI in.
GOOGLE_CLOUD_LOCATION=us-central1

# Which model to use on Vertex AI. Check the Vertex AI Model Garden / docs
# for the current Gemini model IDs available in your region.
VERTEX_MODEL=gemini-2.5-flash

# Demo mode:
#   auto  = use the real AI if GOOGLE_CLOUD_PROJECT is set, otherwise show
#           sample output
#   true  = always show sample output (no Google Cloud project needed, costs
#           nothing)
#   false = always use the real AI (errors if no project is configured)
DEMO_MODE=auto

# Specialist selection (controls cost per case):
#   relevant = convene only the specialists relevant to each case (default,
#              fewer model calls). Always keeps Medical Genetics; falls back to
#              the full board if routing is unsure.
#   all      = always convene all 7 specialists (e.g. for the demo video).
SPECIALIST_SELECTION=relevant

# Max requests per client IP per minute on the board/case endpoints
# (/api/diagnose, /api/intake, /api/teaching/case, /api/cases/*). Protects
# against a single client running up real LLM costs or flooding case storage.
# Set to 0 to disable (e.g. local dev).
RATE_LIMIT_PER_MINUTE=20

# Largest request body accepted, in bytes. Checked before any JSON parsing,
# so an oversized body is rejected before it's ever buffered/validated.
# Default: 10 MB (10485760).
MAX_REQUEST_BODY_BYTES=10485760
